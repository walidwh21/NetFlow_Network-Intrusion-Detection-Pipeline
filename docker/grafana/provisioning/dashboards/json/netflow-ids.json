{
  "uid": "netflow-ids",
  "title": "NetFlow IDS - live predictions",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "ids",
    "netflow"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Attack predictions",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "hadesarchitect-cassandra-datasource",
        "uid": "cassandra"
      },
      "targets": [
        {
          "datasource": {
            "type": "hadesarchitect-cassandra-datasource",
            "uid": "cassandra"
          },
          "refId": "A",
          "queryType": "query",
          "rawQuery": true,
          "target": "SELECT count(*) AS attacks FROM netflow.predictions WHERE is_anomaly = 1 ALLOW FILTERING"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Benign predictions",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "hadesarchitect-cassandra-datasource",
        "uid": "cassandra"
      },
      "targets": [
        {
          "datasource": {
            "type": "hadesarchitect-cassandra-datasource",
            "uid": "cassandra"
          },
          "refId": "A",
          "queryType": "query",
          "rawQuery": true,
          "target": "SELECT count(*) AS benign FROM netflow.predictions WHERE is_anomaly = 0 ALLOW FILTERING"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Latest predictions",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "hadesarchitect-cassandra-datasource",
        "uid": "cassandra"
      },
      "targets": [
        {
          "datasource": {
            "type": "hadesarchitect-cassandra-datasource",
            "uid": "cassandra"
          },
          "refId": "A",
          "queryType": "query",
          "rawQuery": true,
          "target": "SELECT src_ip, dst_ip, src_port, dst_port, protocol, is_anomaly, anomaly_score, ingestion_time FROM netflow.predictions LIMIT 100"
        }
      ]
    }
  ]
}